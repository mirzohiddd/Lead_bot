NODE_ENV=development
PORT=3000

# BotFather bergan token
TELEGRAM_BOT_TOKEN=your_bot_token
# Sizning shaxsiy Telegram ID raqamingiz (TELEGRAM_NOTIFY_ADMIN=true bo'lsa ishlatiladi)
TELEGRAM_ADMIN_ID=your_admin_id
# Buyurtmalar keladigan guruh ID (odatda -100 bilan boshlanadi)
TELEGRAM_GROUP_ID=-1001234567890

# true bo'lsa, har bir buyurtma adminga ham shaxsiy xabar sifatida yuboriladi
TELEGRAM_NOTIFY_ADMIN=false

# Ruxsat berilgan frontend manzil(lar)i. Bir nechta bo'lsa — vergul bilan:
# FRONTEND_URL=https://gepomer.uz,https://www.gepomer.uz
FRONTEND_URL=http://localhost:5173

# ---- Ixtiyoriy sozlamalar (standart qiymatlari ko'rsatilgan) ----
# Backend Nginx/Cloudflare ortida bo'lsa 1 qiling (rate limit to'g'ri IP ko'rishi uchun)
TRUST_PROXY=0
# Bir IP dan 15 daqiqada nechta buyurtma qabul qilinadi
RATE_LIMIT_MAX=10
# Shu daqiqa ichida bir xil telefon raqamdan kelgan takroriy ariza yangi buyurtma yaratmaydi
DEDUP_WINDOW_MINUTES=5
# Telegramga yuborilmagan buyurtmalarni qayta yuborish oralig'i (soniya)
TELEGRAM_RETRY_INTERVAL_SECONDS=60
# Necha marta urinishdan keyin "failed" deb belgilanadi
TELEGRAM_MAX_ATTEMPTS=20
# Buyurtmalar fayli (backend papkasiga nisbatan)
ORDERS_FILE=data/orders.json
