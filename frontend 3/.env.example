# ================= DERMOLIFE COMPLEX — frontend sozlamalari =================
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
# Bu yerga hech qachon Telegram bot tokeni yoki chat ID yozmang — ular faqat backend'da saqlanadi.

# Backend manzili (oxirida / belgisisiz).
# Bo'sh qolsa: production'da buyurtma yuborilmaydi va formada "tizim ulanmagan" xabari chiqadi;
#              dev rejimda (npm run dev) /api so'rovlari localhost:3000 ga yo'naltiriladi.
# Masalan: VITE_API_URL=https://sizning-backend.onrender.com
VITE_API_URL=

# DERMOLIFE uchun alohida Meta Pixel ID (faqat raqamlar). Bo'sh qolsa — pixel yuklanmaydi.
VITE_META_PIXEL_ID=

# Meta Pixel rozilik rejimi:
#   bo'sh     — pixel darhol ishlaydi
#   required  — pastda rozilik paneli chiqadi; "Розиман" bosilmaguncha Meta'ga hech narsa yuborilmaydi
VITE_TRACKING_CONSENT=

# Maxfiylik siyosati sahifasi. Bo'sh qolsa — public/privacy.html ishlatiladi.
VITE_PRIVACY_URL=
